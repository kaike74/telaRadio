# Exemplo de arquivo .env para desenvolvimento local
# Copie para .env e preencha com seus valores

# NÃO commite o arquivo .env real - apenas este .env.example

# API Keys (configure via wrangler secret em produção)
API_KEY=sua-api-key-audiency-aqui
GEONAMES_USERNAME=seu-username-geonames-aqui

# Cloudflare (para GitHub Actions)
# Configure como secrets no GitHub
CLOUDFLARE_API_TOKEN=seu-token-cloudflare
CLOUDFLARE_ACCOUNT_ID=seu-account-id
